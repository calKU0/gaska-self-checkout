<?xml version="1.0" encoding="utf-8"?>
<!--
  Kiosk publish (Visual Studio: Publish → "SelfCheckout", or deploy\publish.ps1).
  x86 – cdn_api.dll of Comarch ERP XL is 32-bit. Framework-dependent: the workstation needs ASP.NET Core Runtime 10 (x86).
  The output folder is never cleaned – data\ (station settings, transaction journal) and logs\ of a workstation survive
  a publish straight into its folder. appsettings.Local.json (credentials) is published when present.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishUrl>..\..\publish\</PublishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>
