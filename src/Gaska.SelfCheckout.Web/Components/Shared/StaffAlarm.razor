@* Plays the staff alarm on the speaker while an alert is sounding (see StaffAlerts); no markup of its own. *@
@implements IAsyncDisposable
@inject StaffAlerts Alerts
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptionsMonitor<Gaska.SelfCheckout.Application.Options.KioskOptions> Options

@code {
    private IJSObjectReference? _module;

    protected override void OnInitialized() => Alerts.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/alarm.js");
        await UpdateAsync();
    }

    private void OnChanged() => InvokeAsync(UpdateAsync);

    private async Task UpdateAsync()
    {
        if (_module is null)
            return;
        try
        {
            if (Alerts.Sounding is { } alert)
                await _module.InvokeVoidAsync("start", alert.Kind == StaffAlertKind.HelpRequest ? "help" : "fault", Options.CurrentValue.AlarmVolume);
            else
                await _module.InvokeVoidAsync("stop");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        Alerts.Changed -= OnChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
