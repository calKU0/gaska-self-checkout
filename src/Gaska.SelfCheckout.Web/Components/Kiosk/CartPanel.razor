@* Customer cart with the total and the pay button. *@
@inherits SessionComponent
@inject IJSRuntime JS

<aside class="panel cart-panel @(Open ? "open" : null)" aria-label="Koszyk">
    <div class="cart-header">
        <h2>Koszyk</h2>
        <div style="display:flex; gap:8px; align-items:center">
            <span class="doc-badge">@(Session.IsInvoice ? "Faktura" : "Paragon")</span>
            @if (!Session.Cart.IsEmpty)
            {
                <span class="badge">@Fmt.Number(Session.Cart.ItemCount) szt.</span>
            }
            @if (Open)
            {
                <button class="btn btn-ghost btn-icon btn-sm" @onclick="OnClose" aria-label="Zamknij koszyk"><Icon Name="x" /></button>
            }
        </div>
    </div>

    @if (Session.Cart.IsEmpty)
    {
        <div class="cart-empty">
            <div>
                <Icon Name="cart" StrokeWidth="1.5" />
                <h3 style="margin-top:12px">Koszyk jest pusty</h3>
                <p>Zeskanuj kod kreskowy produktu<br />lub wyszukaj go na ekranie.</p>
            </div>
        </div>
    }
    else
    {
        <div class="cart-lines">
            @foreach (var line in Session.Cart.Lines)
            {
                var shown = line.ShownQuote;
                var pending = shown is null; // a new line – a changed quantity shows its previous price until recalculated
                var nextTier = Session.QuantityBreaks(line.Product.Id).FirstOrDefault(t => t.Quantity > line.Quantity);
                var pickup = line.Allocations.Where(a => !a.IsPrimary).Sum(a => a.Quantity);
                <div class="cart-line @(line.Product.Id == Session.LastAddedProductId ? "flash" : null)" @key="line.Product.Id" data-product="@line.Product.Id">
                    <div>
                        <div class="title">@line.Product.Name</div>
                        <div class="code">@line.Product.Code</div>
                        @if (pickup > 0)
                        {
                            <div class="secondary-stock"><Icon Name="map" Class="inline-icon" /> @Fmt.Number(pickup) @line.Product.Unit do odbioru z magazynu</div>
                        }
                        @if (nextTier is not null && !pending && nextTier.Quote.Price < line.ShownUnitPrice && nextTier.Quantity <= line.Product.AvailableQuantity)
                        {
                            <div class="tier-hint">Od @Fmt.Number(nextTier.Quantity) @line.Product.Unit taniej: @Fmt.Money(nextTier.Quote.Price) / @line.Product.Unit</div>
                        }
                    </div>
                    <div class="line-total tabular @(!pending && line.ShownDiscount > 0 ? "discounted" : null)">
                        @if (pending)
                        {
                            <span class="price-pending"></span>
                        }
                        else
                        {
                            @Fmt.Money(line.ShownTotal)
                            @if (line.ShownDiscount > 0)
                            {
                                <span class="list-price">@Fmt.Money(line.ShownListTotal)</span>
                            }
                        }
                    </div>
                    <div class="controls">
                        <div class="stepper">
                            <button @onclick="() => Session.SetQuantity(line.Product.Id, line.Quantity - 1)" aria-label="Zmniejsz ilość"><Icon Name="minus" /></button>
                            <span>@Fmt.Number(line.Quantity)</span>
                            <button @onclick="() => Session.SetQuantity(line.Product.Id, line.Quantity + 1)" disabled="@(line.Quantity >= line.Product.AvailableQuantity)" aria-label="Zwiększ ilość"><Icon Name="plus" /></button>
                        </div>
                        <span class="unit-price">
                            @(pending ? "liczymy cenę…" : $"{Fmt.Money(line.ShownUnitPrice)} / {line.Product.Unit}")
                            @if (!pending && line.ShownDiscountPercent > 0)
                            {
                                <span class="discount-badge">rabat −@line.ShownDiscountPercent%</span>
                            }
                        </span>
                        <button class="remove-btn" @onclick="() => Session.Remove(line.Product.Id)" aria-label="Usuń z koszyka"><Icon Name="trash" /></button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="cart-footer">
        @* stays while prices are recalculated – the footer does not change its height on every scan *@
        @if (Session.Cart.ShownDiscount > 0)
        {
            <div class="cart-discount">
                <span>Rabat</span>
                <span class="tabular">@(Session.Cart.HasShownPrices ? "−" + Fmt.Money(Session.Cart.ShownDiscount) : "…")</span>
            </div>
        }
        <div class="cart-total">
            <span class="label">Do zapłaty</span>
            <span class="amount">@(Session.Cart.HasShownPrices ? Fmt.Money(Session.Cart.ShownTotal) : "…")</span>
        </div>
        <button class="btn btn-primary btn-xl btn-block" disabled="@(Session.Cart.IsEmpty || Session.PricesPending)" @onclick="OnPay">
            @* payment waits for the prices of the current quantities; the label changes only while a total is unknown *@
            <Icon Name="card" /> @(Session.Cart.HasShownPrices ? "Zapłać" : "Liczymy ceny…")
        </button>
        <button class="btn btn-ghost btn-block btn-sm" @onclick="OnCancelShopping">Anuluj zakupy</button>
    </div>
</aside>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPay { get; set; }
    [Parameter] public EventCallback OnCancelShopping { get; set; }

    private IJSObjectReference? _module;
    private int _scrolledSequence;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // a product was added – show its line (rendered by now)
        if (Session.AddSequence == _scrolledSequence || Session.LastAddedProductId is not { } productId)
            return;
        _scrolledSequence = Session.AddSequence;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kiosk.js");
            await _module.InvokeVoidAsync("scrollCartTo", productId);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
